{
  "name": "tidelog-license-api",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tidelog-license-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute tidelog-license-db --remote --file=schema.sql",
    "db:migrate:v2": "wrangler d1 execute tidelog-license-db --remote --file=migration-v2.sql",
    "db:migrate:v3": "wrangler d1 execute tidelog-license-db --remote --file=migration-v3.sql",
    "test:quota": "node test-quota.mjs",
    "test:portal": "node test-portal.mjs",
    "generate-keys": "node scripts/generate-keys.mjs",
    "db:migrate:v4": "wrangler d1 execute tidelog-license-db --remote --file=migration-v4.sql",
    "test:moderation": "node test-moderation.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240529.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.60.0"
  }
}